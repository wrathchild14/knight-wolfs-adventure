{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    { "name": "default", "displayName": "Desktop game", "binaryDir": "${sourceDir}/build", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "core-tests", "displayName": "Gameplay tests without graphics dependencies", "binaryDir": "${sourceDir}/build-core", "cacheVariables": { "KWA_BUILD_GAME": "OFF", "BUILD_TESTING": "ON", "CMAKE_BUILD_TYPE": "Debug" } }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release" },
    { "name": "core-tests", "configurePreset": "core-tests" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "core-tests", "configurePreset": "core-tests", "output": { "outputOnFailure": true } }
  ]
}
